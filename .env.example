# Portal FM Transportes — desenvolvimento local
# Copiar para `.env` e `backend/.env`. Nunca versionar `.env` real.

# PostgreSQL local
DATABASE_URL=postgresql://postgree:postgree@127.0.0.1:5432/fm_auto?schema=public

# API
PORT=3000
CORS_ORIGIN=http://localhost:5190,http://127.0.0.1:5190
NODE_ENV=development

# JWT (access + refresh) — cookies httpOnly
# Em produção: secrets longos e aleatórios (sem "change-in-prod")
JWT_ACCESS_SECRET=fm-dev-access-secret-change-in-prod
JWT_REFRESH_SECRET=fm-dev-refresh-secret-change-in-prod
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Seed de usuário demo no boot da API (só local). Em clone/prod: false ou omitir.
SEED_DEMO_USER_ON_BOOT=true

# --- Frontend (opcional) ---
# VITE_API_URL=http://localhost:3000/api

# --- Integrações externas (NUNCA colocar senhas reais neste arquivo) ---
# Credenciais de GW, OTM e SFTP ficam na pasta guarda-chuva FM Transportes/Acessos/
# GW_API_BASE_URL=
# GW_API_TOKEN=
# OTM_BASE_URL=
# SFTP_HOST=
# SFTP_USER=
# SFTP_REMOTE_PATH=
